{
  "name": "east-of-town-pos",
  "version": "0.6.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "test:desktop": "node scripts/desktop-smoke.cjs && node scripts/billing-desktop.cjs && node scripts/reports-desktop.cjs && node scripts/controls-desktop.cjs && node scripts/release-desktop.cjs && node scripts/navigation-desktop.cjs",
    "test:ui-errors": "node scripts/ui-errors-test.cjs",
    "test:navigation-desktop": "node scripts/navigation-desktop.cjs",
    "test:reports-desktop": "node scripts/reports-desktop.cjs",
    "test:billing-desktop": "node scripts/billing-desktop.cjs",
    "test:api": "node scripts/backend-smoke.cjs",
    "dev": "vite --config frontend/vite.config.ts",
    "build:share": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-share.ps1",
    "test:stage6-desktop": "node scripts/release-desktop.cjs",
    "test:share": "node scripts/share-bridge-test.cjs && node scripts/share-smoke.cjs",
    "test:packaged": "node scripts/packaged-smoke.cjs",
    "release:check": "node scripts/release-check.cjs",
    "build": "tsc --noEmit && vite build --config frontend/vite.config.ts",
    "start": "electron .",
    "package:win": "npm run build && npm run build:share && electron-builder --win nsis",
    "package:win:signed": "npm run build && npm run build:share && electron-builder --win nsis --config.forceCodeSigning=true",
    "package:dir": "npm run build && npm run build:share && electron-builder --win --dir"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "build": {
    "appId": "com.eastoftown.pos",
    "productName": "East of Town",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "output/pdf",
        "to": "output/pdf"
      },
      {
        "from": "backend/target/pos-0.6.0.jar",
        "to": "backend/pos.jar"
      },
      {
        "from": "native/bin",
        "to": "native"
      },
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
